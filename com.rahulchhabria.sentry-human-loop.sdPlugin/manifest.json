{
	"Name": "Sentry",
	"Version": "0.1.0.0",
	"Author": "Rahul Chhabria",
	"Actions": [
		{
			"Name": "Pulse",
			"UUID": "com.rahulchhabria.sentry-human-loop.error-pulse",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Flashes on genuinely new Sentry issues; short press acknowledges and selects; long press toggles mute.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 18
				}
			]
		},
		{
			"Name": "This Issue",
			"UUID": "com.rahulchhabria.sentry-human-loop.review-issue",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Shows the selected issue. Short press opens culprit file (best-effort) or Sentry. Long press selects next.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Next Issue",
			"UUID": "com.rahulchhabria.sentry-human-loop.next-issue",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Selects the next highest-pain unresolved issue (wraps).",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Send to Agent",
			"UUID": "com.rahulchhabria.sentry-human-loop.send-to-agent",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Sends the selected issue to your local coding agent via CLI. Long press explicitly asks for a draft PR.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Loop",
			"UUID": "com.rahulchhabria.sentry-human-loop.loop",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Shows follow-up status after SEND: DRAFT, CI, FAIL, MERGED, or SENT when no PR is found.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Done",
			"UUID": "com.rahulchhabria.sentry-human-loop.done",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Resolve (short) or archive (long) the selected issue via Sentry API. Requires event:write.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		}
	],
	"Category": "Sentry",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "A 6-key human-in-the-loop pipeline for Sentry on a Stream Deck: PULSE / THIS / NEXT / SEND / LOOP / DONE. Navigate highest-pain issues, hand off to a local agent, follow draft PR status, and resolve/archive.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.rahulchhabria.sentry-human-loop"
}