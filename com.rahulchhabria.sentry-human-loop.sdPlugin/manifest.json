{
	"Name": "Sentry",
	"Version": "0.1.0.0",
	"Author": "Rahul Chhabria",
	"Actions": [
		{
			"Name": "Error Pulse",
			"UUID": "com.rahulchhabria.sentry-human-loop.error-pulse",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Pulses red when a new Sentry issue fires; press to open it for review.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 18
				}
			]
		},
		{
			"Name": "Previous Issue",
			"UUID": "com.rahulchhabria.sentry-human-loop.previous-issue",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Selects the previous unresolved issue in the shared Sentry queue.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Selected Issue",
			"UUID": "com.rahulchhabria.sentry-human-loop.review-issue",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Shows and opens the issue selected by the shared Sentry queue.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Next Issue",
			"UUID": "com.rahulchhabria.sentry-human-loop.next-issue",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Selects the next unresolved issue in the shared Sentry queue.",
			"PropertyInspectorPath": "ui/sentry-settings.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Agent Plan",
			"UUID": "com.rahulchhabria.sentry-human-loop.agent-plan",
