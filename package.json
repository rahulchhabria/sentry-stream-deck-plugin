{
    "name": "sentry-stream-deck-plugin",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.rahulchhabria.sentry-human-loop\"",
        "validate": "streamdeck validate com.rahulchhabria.sentry-human-loop.sdPlugin",
        "pack": "streamdeck pack --force com.rahulchhabria.sentry-human-loop.sdPlugin",
        "test": "node --import tsx --test 'src/**/*.test.ts'",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "sim": "tsx scripts/simulate.ts"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "tsx": "^4.23.1",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
