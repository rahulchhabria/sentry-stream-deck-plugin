{
    "name": "sentry-stream-deck-plugin",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "rollup -c",
        "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run validate && npm run pack:check",
        "dev:enable": "streamdeck dev",
        "icons:build": "tsx scripts/export-key-icons.ts",
        "lint": "eslint --quiet",
        "link": "streamdeck link com.rc.sentry-alerts.sdPlugin",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.rc.sentry-alerts\"",
        "validate": "streamdeck validate com.rc.sentry-alerts.sdPlugin",
        "pack:check": "streamdeck pack --dry-run --force com.rc.sentry-alerts.sdPlugin",
        "pack": "streamdeck pack --force com.rc.sentry-alerts.sdPlugin",
        "test": "node --import tsx --test 'src/**/*.test.ts'",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "sim": "tsx scripts/simulate.ts"
    },
    "type": "module",
    "prettier": "@elgato/prettier-config",
    "devDependencies": {
        "@elgato/cli": "^1.8.0",
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "tsx": "^4.23.1",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.1"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
